{
  "name": "pucar-dristi",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pucar/dristi-app",
    "build": "npm run build -w @pucar/dristi-app",
    "start": "npm run start -w @pucar/dristi-app",
    "lint": "npm run lint -w @pucar/dristi-app",
    "check:tokens": "npm run check:tokens -w @pucar/dristi-app",
    "check:typography": "npm run check:typography -w @pucar/dristi-app",
    "check:ui-sync": "npm run check:ui-sync -w @pucar/dristi-app",
    "sync:ui": "npm run sync:ui -w @pucar/dristi-app --"
  }
}
